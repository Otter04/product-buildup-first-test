{
  "name": "minisql",
  "version": "0.1.0",
  "description": "A small, dependency-free relational SQL database engine written in TypeScript — lexer, parser, planner, executor, indexes, transactions and a REPL.",
  "keywords": [
    "sql",
    "database",
    "parser",
    "interpreter",
    "query-engine",
    "typescript"
  ],
  "homepage": "https://github.com/otter04/product-buildup-first-test#readme",
  "bugs": {
    "url": "https://github.com/otter04/product-buildup-first-test/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otter04/product-buildup-first-test.git"
  },
  "license": "MIT",
  "author": "otter04",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "bin": {
    "minisql": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "repl": "npm run build && node dist/cli.js",
    "prepublishOnly": "npm run build",
    "bench": "npm run build && node --no-warnings bench/bench.mjs",
    "examples": "npm run build && node examples/quickstart.mjs && node examples/analytics.mjs && node examples/todo.mjs list",
    "fuzz": "vitest run tests/differential.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
